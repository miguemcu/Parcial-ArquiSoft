# Copia este archivo como .env y completa los valores. El .env está ignorado por git.

# ---------------------------------------------------------------------
# Base de datos: Supabase, Session pooler (funciona en redes solo IPv4).
# No uses db.<ref>.supabase.co: ese host es solo IPv6.
# Usa el puerto 5432 (session), no el 6543 (transaction): Flyway e
# Hibernate necesitan prepared statements y locks de sesión.
# La URL va en formato JDBC y sin credenciales; usuario y clave van aparte.
# ---------------------------------------------------------------------
DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.qqbiotvdhegsbazgwums
DB_PASSWORD=
DB_POOL_MAX_SIZE=5

# ---------------------------------------------------------------------
# Flyway
# true solo en desarrollo local si la base ya tenía tablas creadas a mano
# (marca V1 como aplicada sin ejecutarla).
# ---------------------------------------------------------------------
FLYWAY_BASELINE_ON_MIGRATE=false

# ---------------------------------------------------------------------
# Redis (caché). En docker compose se fuerzan REDIS_HOST=redis y
# REDIS_PORT=6379; estos valores aplican al correr la app fuera de Docker.
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Frontend: orígenes permitidos por CORS, separados por coma.
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5500

# ---------------------------------------------------------------------
# Grafana (docker compose). Obligatoria: el compose no arranca sin ella.
# ---------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
